
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files.
    // This simplifies displaying images in the app.
    // Write access is controlled by more specific rules below.
    match /{allPaths=**} {
      allow read;
    }

    // Secure user-specific uploads.
    // Users can only write to their own folder, identified by their UID.
    match /uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
